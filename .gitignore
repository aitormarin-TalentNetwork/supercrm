# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# restos de sesiones de prueba con Playwright MCP
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# volcados de código para rondas de auditoría externa, no son código de la app
/Sorfware Factory/codigo para auditar/

# copias de trabajo aisladas por terminal (git worktree), una por tarea en curso
/Sorfware Factory/_worktrees/

# cerrojo autoservicio del turno de Convex mientras el deployment siga compartido
# (estado efímero de coordinación entre terminales, no config del proyecto)
/Sorfware Factory/_turno-convex.lock

# modo de publicación del Integrador (confirmar/autonomo) — estado efímero, no config
/Sorfware Factory/_modo-publicacion.txt
