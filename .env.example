# Plantilla de .env.local — copia este archivo a .env.local y rellena los valores.
# Detalle completo de cada variable en docs/03-setup.md (tabla "Variables de entorno").
#
# CONVEX_DEPLOYMENT y NEXT_PUBLIC_CONVEX_URL/NEXT_PUBLIC_CONVEX_SITE_URL las escribe
# automáticamente `npx convex dev` (o `npx convex dev --once` tras un `--configure=new`)
# al enlazar el deployment. No las pongas a mano salvo que sepas lo que haces.

# Deployment de Convex usado en local (lo escribe `npx convex dev`)
CONVEX_DEPLOYMENT=

# URL del deployment de Convex que usa el navegador (pública, sin secretos)
NEXT_PUBLIC_CONVEX_URL=

# URL del sitio de Convex (HTTP actions / Convex Auth)
NEXT_PUBLIC_CONVEX_SITE_URL=

# Autorrelleno de "cuentas de prueba" en /login — solo se usa si NODE_ENV !== "production".
# Deben coincidir con SEED_OWNER_PASSWORD / SEED_SALES_PASSWORD del deployment de Convex
# (esas se fijan con `npx convex env set`, no aquí — ver docs/03-setup.md).
NEXT_PUBLIC_DEMO_OWNER_PASSWORD=
NEXT_PUBLIC_DEMO_SALES_PASSWORD=

# AIT-60: además del login por contraseña, el provider Google (OAuth) vive
# entero en el deployment de Convex — sus credenciales (AUTH_GOOGLE_ID,
# AUTH_GOOGLE_SECRET) se fijan con `npx convex env set`, nunca aquí. No hace
# falta ninguna variable de entorno de Google en .env.local/el frontend —
# ver docs/03-setup.md.

# Clave pública VAPID para Web Push (AIT-57) — pública, sin secretos. La
# privada (VAPID_PRIVATE_KEY) vive solo en el deployment de Convex, nunca
# aquí. Se generan juntas con `npx web-push generate-vapid-keys` — ver
# docs/03-setup.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
